# Required for all scripts
RPC_URL=https://rpc.kasplextest.xyz
DEPLOYER_PK=0xYOUR_DEPLOYER_PRIVATE_KEY

# Required for oracle worker
ORACLE_PK=0xYOUR_ORACLE_PRIVATE_KEY
AGGREGATOR_ADDRESS=0xAGGREGATOR_CONTRACT_ADDRESS
ORDER_MATCHING_ADDRESS=0xORDER_MATCHING_CONTRACT_ADDRESS

# Optional oracle worker tuning
ORACLE_POLL_INTERVAL_MS=15000
ORACLE_AUTO_FINALIZE=true
# Set to true if you want a one-shot run instead of a long-running worker
ORACLE_RUN_ONCE=false

# Required for request scripts (falls back to DEPLOYER_PK if omitted)
REQUESTER_PK=0xYOUR_REQUESTER_PRIVATE_KEY

# Required for request:demo
# Comma-separated oracle private keys for demo bidding/finalize flow
ORACLE_PKS=0xORACLE_PK_1,0xORACLE_PK_2
